{
  "name": "boss-ia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w @boss/web",
    "dev:server": "npm run dev -w @boss/server",
    "build": "npm run build -w @boss/web",
    "start": "npm run start -w @boss/server",
    "test": "npm test -w @boss/core",
    "typecheck": "tsc -p packages/core && tsc -p apps/web --noEmit && tsc -p apps/server --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
