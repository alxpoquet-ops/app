{
  "name": "Publik — vidéos et publications automatiques",
  "short_name": "Publik",
  "description": "Dépose tes photos/vidéos, Publik monte et publie sur tes réseaux.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbf9f6",
  "theme_color": "#fbf9f6",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": { "text": "text" }
  }
}
