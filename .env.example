# Copie ce fichier en `.env` puis complète ce dont tu as besoin.
# Tout peut aussi se régler depuis l'écran « Réglages » de l'app.

# Adresse publique de l'app (obligatoire pour connecter les réseaux en mode direct)
PUBLIC_URL=
# Nom de domaine pour le HTTPS automatique (profil docker « https »), ex : publik.mondomaine.fr
DOMAIN=

# Mot de passe initial (sinon il est demandé au premier lancement)
APP_PASSWORD=

# Clé IA Claude (facultative) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Mode simple : Upload-Post (https://www.upload-post.com)
PUBLISH_MODE=uploadpost
UPLOADPOST_API_KEY=
UPLOADPOST_USER=

# Mode direct : identifiants des applications développeur
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
